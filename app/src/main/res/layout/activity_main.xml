<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <!-- Host chip: tap to pick a host or pair a new one, long-press for settings -->
            <LinearLayout
                android:id="@+id/chip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <View
                    android:id="@+id/dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/host_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/tile"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                android:tint="?android:attr/textColorSecondary" />

            <ImageButton
                android:id="@+id/disconnect"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/tile"
                android:contentDescription="@string/disconnect"
                android:src="@drawable/ic_power"
                android:tint="?android:attr/textColorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tile"
            android:padding="16dp"
            android:text="@string/pair_hint"
            android:textColor="?android:attr/colorAccent"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <com.tauslop.btpad.TouchpadView
                android:id="@+id/pad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/pad" />

            <TextView
                android:id="@+id/pad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/pad_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/unsupported"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/tile"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/unsupported"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:visibility="gone" />
        </FrameLayout>

        <com.tauslop.btpad.KeyStripView
            android:id="@+id/strip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <com.tauslop.btpad.TypeField
            android:id="@+id/type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tile"
            android:hint="@string/type_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="20dp"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
